---
import { diasDesde } from '../lib/fechas';
interface Props {
  href: string;
  kicker: string;
  title: string;
  dek?: string;
  autor?: string;
  fecha: Date;
  monogram?: string;
}
const { href, kicker, title, dek, autor = 'Redacción', fecha, monogram = 'EL' } = Astro.props;
---
<article class="story">
  <span class="kicker">{kicker}</span>
  <h3><a href={href}>{title}</a></h3>
  {dek && <p>{dek}</p>}
  <div class="article-foot">
    <span class="byline">{autor}</span>
    <span class="dot">·</span>
    <span class="meta">{diasDesde(fecha)}</span>
  </div>
</article>
