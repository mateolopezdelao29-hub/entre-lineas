---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { diasDesde } from '../lib/fechas';

const todas = (await getCollection('notas'))
  .filter(n => n.data.seccion === 'datos')
  .sort((a,b) => b.data.fecha.getTime() - a.data.fecha.getTime());
const hero = todas[0];
const otras = todas.slice(1);
---
<BaseLayout title="Datos" active="Datos">
  <header class="sec-head wrap">
    <div class="eyebrow">Sección</div>
    <h1>Datos</h1>
    <p class="desc">Periodismo con evidencia: gráficas, mapas y análisis reproducible. Cada visualización trae su fuente y su base descargable. Los números también cuentan historias.</p>
    <nav class="subtopics" aria-label="Subtemas">
      <a class="on" href="#">Todo</a>
      <a href="#">Presupuesto</a>
      <a href="#">Movilidad</a>
      <a href="#">Agua</a>
      <a href="#">Seguridad</a>
      <a href="#">Elecciones</a>
    </nav>
  </header>

  <main class="wrap">
    <section class="indicators" aria-label="Indicadores">
      <div class="ind">
        <div class="l">Quejas ciudadanas este mes</div>
        <div class="n">8,412</div>
        <svg class="spark" viewBox="0 0 120 26" preserveAspectRatio="none">
          <polyline points="0,20 20,18 40,19 60,14 80,12 100,8 120,5" fill="none" stroke="#21384A" stroke-width="2"/>
          <circle cx="120" cy="5" r="2.6" fill="#B23127"/>
        </svg>
        <div class="delta up">▲ 12% vs. mes previo</div>
      </div>
      <div class="ind">
        <div class="l">Tiempo medio de atención</div>
        <div class="n">14 d</div>
        <svg class="spark" viewBox="0 0 120 26" preserveAspectRatio="none">
          <polyline points="0,8 20,10 40,9 60,13 80,15 100,18 120,20" fill="none" stroke="#21384A" stroke-width="2"/>
          <circle cx="120" cy="20" r="2.6" fill="#21384A"/>
        </svg>
        <div class="delta down">▼ 3 días vs. trimestre</div>
      </div>
      <div class="ind">
        <div class="l">Gasto por adjudicación directa</div>
        <div class="n">$412M</div>
        <svg class="spark" viewBox="0 0 120 26" preserveAspectRatio="none">
          <polyline points="0,18 20,16 40,17 60,12 80,13 100,7 120,6" fill="none" stroke="#21384A" stroke-width="2"/>
          <circle cx="120" cy="6" r="2.6" fill="#B23127"/>
        </svg>
        <div class="delta up">▲ 21% vs. año previo</div>
      </div>
      <div class="ind">
        <div class="l">Colonias sin datos completos</div>
        <div class="n">37</div>
        <svg class="spark" viewBox="0 0 120 26" preserveAspectRatio="none">
          <polyline points="0,10 20,11 40,9 60,10 80,12 100,11 120,12" fill="none" stroke="#21384A" stroke-width="2"/>
          <circle cx="120" cy="12" r="2.6" fill="#21384A"/>
        </svg>
        <div class="delta">Sin cambio relevante</div>
      </div>
    </section>

    {hero && (
      <section class="hero">
        <div class="txt">
          <span class="kicker">{hero.data.subtema ?? 'Datos'} · Análisis</span>
          <h2><a href={`/nota/${hero.id}/`}>{hero.data.title}</a></h2>
          <p class="deck">{hero.data.dek}</p>
          <a class="dl" href="#">⤓ Descargar base de datos (CSV)</a>
        </div>
        <figure class="viz">
          <div class="viz-title">Gasto por tipo de contratación, 2016–2025</div>
          <div class="viz-sub">Millones de pesos · azul: licitación · rojo: adjudicación directa</div>
          <svg viewBox="0 0 520 240" role="img">
            <g stroke="#EDE9DF" stroke-width="1">
              <line x1="40" y1="40" x2="510" y2="40"/>
              <line x1="40" y1="90" x2="510" y2="90"/>
              <line x1="40" y1="140" x2="510" y2="140"/>
              <line x1="40" y1="190" x2="510" y2="190"/>
            </g>
            <line x1="40" y1="200" x2="510" y2="200" stroke="#CBC4B5"/>
            <line x1="40" y1="30" x2="40" y2="200" stroke="#CBC4B5"/>
            <path d="M40,150 L92,140 L145,145 L197,130 L250,120 L302,118 L355,110 L407,112 L460,100 L510,95 L510,200 L40,200 Z" fill="#7B94A6" opacity="0.35"/>
            <polyline points="40,150 92,140 145,145 197,130 250,120 302,118 355,110 407,112 460,100 510,95" fill="none" stroke="#21384A" stroke-width="2"/>
            <polyline points="40,180 92,170 145,150 197,155 250,120 302,135 355,110 407,120 460,78 510,70" fill="none" stroke="#B23127" stroke-width="2.5"/>
            <g stroke="#B23127" stroke-width="1" stroke-dasharray="3 3" opacity="0.55">
              <line x1="250" y1="30" x2="250" y2="200"/>
              <line x1="460" y1="30" x2="460" y2="200"/>
            </g>
            <text x="250" y="24" text-anchor="middle" font-family="Archivo,sans-serif" font-size="9" fill="#B23127">elección</text>
            <text x="460" y="24" text-anchor="middle" font-family="Archivo,sans-serif" font-size="9" fill="#B23127">elección</text>
            <text x="40" y="216" font-family="Archivo,sans-serif" font-size="9" fill="#6E675B">2016</text>
            <text x="242" y="216" font-family="Archivo,sans-serif" font-size="9" fill="#6E675B">2020</text>
            <text x="486" y="216" font-family="Archivo,sans-serif" font-size="9" fill="#6E675B">2025</text>
          </svg>
          <div class="viz-foot">Fuente: padrones de contratación · Datos ilustrativos · Entre Líneas</div>
        </figure>
      </section>
    )}

    {otras.length > 0 && (
      <>
        <div class="grid-head" style="margin-top:56px;"><span>Más visualizaciones</span></div>
        <section class="grid">
          {otras.map(n => (
            <article class="story">
              <span class="kicker">{n.data.subtema ?? 'Datos'}</span>
              <h3><a href={`/nota/${n.id}/`}>{n.data.title}</a></h3>
              <p>{n.data.dek}</p>
              <div class="article-foot">
                <span class="tag-data">⤓ Datos</span><span class="dot">·</span>
                <span class="meta">{diasDesde(n.data.fecha)}</span>
              </div>
            </article>
          ))}
        </section>
      </>
    )}

    <div class="loadmore"><a href="#">Ver todos los análisis</a></div>
  </main>
</BaseLayout>
