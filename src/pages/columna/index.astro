---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { fechaCorta } from '../../lib/fechas';

const cols = (await getCollection('columnas')).sort((a,b) => b.data.fecha.getTime() - a.data.fecha.getTime());
const ultima = cols[0];
const anteriores = cols.slice(1);
const { Content } = ultima ? await render(ultima) : { Content: null as any };
---
<BaseLayout title="La Columna" active="Opinión">
  <header class="author-hero">
    <div class="wrap">
      <div class="col-label">Opinión · Columna</div>
      <div class="portrait" style="background: url('/carlos.jpg') center/cover; color: transparent;">C</div>
      <h1>Carlos De la O</h1>
      <div class="cadence">Cada jueves</div>
      <p class="bio"><p class="bio">Camino diario la Benito Juárez. Delegado en la Fundación México con Valores. Uso esta columna para pensar en voz alta — sobre la política que sí cambia cosas, y sobre por qué hacer el bien no debería mirar a quién.</p>.</p>
      <div class="cta-row">
        <a class="btn" href="/nosotros/">Suscríbete a la columna</a>
        <a class="btn ghost" href="/nosotros/">Newsletter semanal</a>
      </div>
    </div>
  </header>

  {ultima && (
    <>
      <div class="wrap"><div class="band"><span>La columna de esta semana</span></div></div>
      <article>
        <header class="feature-head">
          <div class="date">{fechaCorta(ultima.data.fecha)}{ultima.data.edicion ? ` · ${ultima.data.edicion}` : ''}</div>
          <h2>{ultima.data.title}</h2>
          <p class="deck">{ultima.data.dek}</p>
        </header>
        <div class="read col-body">
          <Content />
        </div>
      </article>
    </>
  )}

  {anteriores.length > 0 && (
    <section class="archive wrap">
      <div class="band"><span>Columnas anteriores</span></div>
      <div class="arch-list">
        {anteriores.map(c => (
          <article class="arch-item">
            <div class="d">{fechaCorta(c.data.fecha)}</div>
            <div>
              <h3><a href={`/columna/${c.id}/`}>{c.data.title}</a></h3>
              <p>{c.data.dek}</p>
            </div>
            <div class="num">{c.data.edicion ?? ''}</div>
          </article>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
