---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  active?: string;      // 'Investigación' | 'Nacional' | ...
  compactHeader?: boolean; // true = mini masthead, false = full masthead
  footerVariant?: 'simple' | 'full';
}

const {
  title,
  description = 'Periodismo de investigación y opinión desde la Ciudad de México.',
  active,
  compactHeader = true,
  footerVariant = 'simple',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="es-MX">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title} — Entre Líneas</title>
<meta name="description" content={description} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Display&family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400;1,700&family=Spectral:ital,wght@0,400;0,500;0,600;1,400;1,600&family=Archivo:wght@500;600;700&display=swap" rel="stylesheet" />
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body>
  <SiteHeader compact={compactHeader} active={active} />
  <slot />
  <SiteFooter variant={footerVariant} />
  <script is:inline>
    (function(){
      var dias=["domingo","lunes","martes","miércoles","jueves","viernes","sábado"];
      var meses=["enero","febrero","marzo","abril","mayo","junio","julio","agosto","septiembre","octubre","noviembre","diciembre"];
      var d=new Date();
      var f=dias[d.getDay()]+", "+d.getDate()+" de "+meses[d.getMonth()]+" de "+d.getFullYear();
      f=f.charAt(0).toUpperCase()+f.slice(1);
      var el=document.getElementById("fecha"); if(el){el.textContent=f+" · Ciudad de México";}
      var y=document.getElementById("anio"); if(y){y.textContent=d.getFullYear();}
      var dow=d.getDay();
      var cell=document.querySelector('#roster .day[data-dow="'+dow+'"]');
      if(cell){cell.classList.add('today');}
    })();
  </script>
  <script is:inline>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", function(user){
        if (!user) {
          window.netlifyIdentity.on("login", function(){
            document.location.href = "/admin/";
          });
        }
      });
    }
  </script>
</body>
</html>
</html>
